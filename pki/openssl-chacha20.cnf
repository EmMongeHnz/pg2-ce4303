# Restricts the TLS 1.3 cipher suites of a process to ChaCha20-Poly1305.
# Python's ssl module cannot set TLS 1.3 suites, so launch the node with:
#   OPENSSL_CONF=pki/openssl-chacha20.cnf uv run astrea-worker ...
# Use it on the Raspberry Pi 3, which has no AES acceleration.
openssl_conf = default-conf

[default-conf]
ssl_conf = ssl-section

[ssl-section]
system_default = system-default-section

[system-default-section]
Ciphersuites = TLS_CHACHA20_POLY1305_SHA256
