digraph AstreaView {
  graph [rankdir=TB, fontname="Helvetica", nodesep=0.5, ranksep=0.75, pad=0.3, compound=true,
         label=<<B>AstreaView — Diagrama de bloques</B><BR/><FONT POINT-SIZE="10">Borde discontinuo = componente opcional (fase 8)</FONT><BR/> >,
         labelloc=t, fontsize=18, splines=true, newrank=true];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, fillcolor="#ffffff", color="#444444", margin="0.15,0.07"];
  edge  [fontname="Helvetica", fontsize=9, color="#555555"];

  subgraph cluster_scene {
    label=<<B>Escena de captura</B>>; style="rounded,filled"; fillcolor="#f3f3f3"; color="#999999";
    object [label="Objeto", shape=ellipse, fillcolor="#fff7e0"];
    base   [label="Base giratoria manual\n+ anillo ArUco"];
  }

  subgraph cluster_phone {
    label=<<B>iPhone</B>>; style="rounded,filled"; fillcolor="#e8f1fb"; color="#4a7fb5";
    truedepth [label="Cámara TrueDepth\n(RGB + profundidad)"];
    record3d  [label="App Record3D\n(streaming USB)"];
  }

  subgraph cluster_host {
    label=<<B>Host PC — nodo 1</B>>; style="rounded,filled"; fillcolor="#e9f6ec"; color="#4c9a5f";
    capture     [label="capture-service\ntracking ArUco · keyframes"];
    coordinator [label="coordinator\nreparto · merge TSDF · mallado · LOD"];
    workerA     [label="worker\nfusión TSDF parcial"];
    hostctl     [label="Estado de cámara\n(fuente de verdad)"];
    viewer      [label="renderer --mode viewer\n(C + raylib)"];
    mouse       [label="Mouse / teclado", shape=component];
  }

  subgraph cluster_workerb {
    label=<<B>Worker B — nodo 2</B>>; style="rounded,filled"; fillcolor="#f4ecf8"; color="#8a5aa8";
    workerB [label="worker\nfusión TSDF parcial"];
  }

  subgraph cluster_pi {
    label=<<B>Raspberry Pi 3 — nodo 3 (dispositivo)</B>>; style="rounded,filled"; fillcolor="#fdeeee"; color="#b55a5a";
    subgraph cluster_user {
      label="Espacio de usuario"; style="rounded,filled"; fillcolor="#ffffff"; color="#cc9999";
      workerC [label="worker (ligero)\nfusión TSDF parcial"];
      agent   [label="device-agent\n(Python)"];
      holo    [label="renderer --mode hologram\n(DRM / GLES2)"];
    }
    subgraph cluster_kernel {
      label="Espacio de kernel — módulo holo-io"; style="rounded,filled"; fillcolor="#fbe0e0"; color="#b55a5a";
      devinput [label="/dev/holo-input\nIRQ · debounce · kfifo · poll · ioctl · sysfs"];
      devturn  [label="/dev/turntable\nhrtimer · ioctl · poll", style="rounded,dashed,filled", fillcolor="#fdf3f3"];
    }
  }

  subgraph cluster_hw {
    label=<<B>Hardware conectado a la Pi</B>>; style="rounded,filled"; fillcolor="#f3f3f3"; color="#999999";
    joystick [label="Joystick arcade\n4 direcciones + 4 botones"];
    zx       [label="ZX Gesture Sensor", style="rounded,dashed,filled", fillcolor="#fafafa"];
    stepper  [label="28BYJ-48 + ULN2003\n(mueve la base)", style="rounded,dashed,filled", fillcolor="#fafafa"];
  }

  subgraph cluster_display {
    label=<<B>Display Pepper's Ghost</B>>; style="rounded,filled"; fillcolor="#f3f3f3"; color="#999999";
    monitor [label="Monitor HDMI\n(boca arriba)"];
    panel   [label="Panel PETG/acrílico 45°\n+ caja negra"];
    viewerP [label="Observador", shape=ellipse, fillcolor="#fff7e0"];
  }

  { rank=same; object; truedepth; }
  { rank=same; base; record3d; }

  object -> base [label=" sobre", style=dotted, arrowhead=none];
  object -> truedepth [label="escena", style=dotted];
  truedepth -> record3d;
  record3d -> capture [label=" USB (usbmuxd)\n RGB-D + intrínsecas", penwidth=1.8, color="#4a7fb5", fontcolor="#4a7fb5"];

  capture -> coordinator [label=" keyframes + poses"];
  coordinator -> workerA [dir=both];
  coordinator -> viewer  [label=" GLB LOD-high"];
  mouse -> hostctl;
  hostctl -> viewer [label=" socket Unix"];

  coordinator -> workerB [dir=both, color="#2e7d32", fontcolor="#2e7d32", penwidth=1.8, label=" N1"];
  coordinator -> workerC [dir=both, color="#2e7d32", fontcolor="#2e7d32", penwidth=1.8, label=" N1"];
  coordinator -> agent   [color="#2e7d32", fontcolor="#2e7d32", penwidth=1.8, label=" N2"];
  hostctl -> agent [dir=both, color="#2e7d32", fontcolor="#2e7d32", penwidth=1.8, headlabel="N3", labeldistance=2.5, labelangle=25];
  capture -> agent [dir=both, style=dashed, color="#2e7d32", fontcolor="#2e7d32", label=" N4"];

  devinput -> agent [label=" read() / poll()\n struct HoloEvent"];
  agent -> devturn  [style=dashed, label=" ioctl(ROTATE)"];
  agent -> holo     [label=" socket Unix\n modelo + estado"];

  joystick -> devinput [dir=back, color="#b55a5a", fontcolor="#b55a5a", penwidth=1.8, taillabel="H1", labeldistance=2.2, labelangle=-30];
  zx -> devinput       [dir=back, style=dashed, color="#b55a5a", fontcolor="#b55a5a", taillabel="H2", labeldistance=2.2, labelangle=30];
  stepper -> devturn   [dir=back, style=dashed, color="#b55a5a", fontcolor="#b55a5a", label=" H3"];
  stepper -> base      [style=dashed, label=" giro", constraint=false];

  holo -> monitor  [penwidth=1.8, label=" HDMI"];
  monitor -> panel [label=" luz"];
  panel -> viewerP [label=" reflejo\n (imagen virtual)"];

  subgraph cluster_legend {
    label=<<B>Leyenda</B>>; style="rounded"; color="#999999"; fontsize=11;
    legend [shape=plaintext, style="", label=<
      <TABLE BORDER="0" CELLSPACING="4">
        <TR><TD ALIGN="LEFT"><FONT COLOR="#2e7d32">━━━</FONT></TD><TD ALIGN="LEFT">Red cifrada: TCP + mTLS (TLS 1.3)</TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#b55a5a">━━━</FONT></TD><TD ALIGN="LEFT">Hardware ↔ kernel (GPIO / I2C)</TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#4a7fb5">━━━</FONT></TD><TD ALIGN="LEFT">USB (captura RGB-D)</TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#555555">━━━</FONT></TD><TD ALIGN="LEFT">Local (proceso / socket Unix / HDMI)</TD></TR>
        <TR><TD ALIGN="LEFT">- - -</TD><TD ALIGN="LEFT">Opcional (fase 8)</TD></TR>
        <TR><TD COLSPAN="2"> </TD></TR>
        <TR><TD ALIGN="LEFT"><B><FONT COLOR="#2e7d32">N1</FONT></B></TD><TD ALIGN="LEFT">JOB_ASSIGN / JOB_RESULT (vistas → bloques TSDF)</TD></TR>
        <TR><TD ALIGN="LEFT"><B><FONT COLOR="#2e7d32">N2</FONT></B></TD><TD ALIGN="LEFT">MODEL_PUSH (GLB LOD-low, chunks + SHA-256)</TD></TR>
        <TR><TD ALIGN="LEFT"><B><FONT COLOR="#2e7d32">N3</FONT></B></TD><TD ALIGN="LEFT">INPUT_EVENT (Pi → host) / CAMERA_STATE (host → Pi)</TD></TR>
        <TR><TD ALIGN="LEFT"><B><FONT COLOR="#2e7d32">N4</FONT></B></TD><TD ALIGN="LEFT">ROTATE / ROTATE_DONE (opcional)</TD></TR>
        <TR><TD ALIGN="LEFT"><B><FONT COLOR="#b55a5a">H1</FONT></B></TD><TD ALIGN="LEFT">GPIO, IRQ en ambos flancos + debounce</TD></TR>
        <TR><TD ALIGN="LEFT"><B><FONT COLOR="#b55a5a">H2</FONT></B></TD><TD ALIGN="LEFT">I2C (0x10) + GPIO data-ready (opcional)</TD></TR>
        <TR><TD ALIGN="LEFT"><B><FONT COLOR="#b55a5a">H3</FONT></B></TD><TD ALIGN="LEFT">4 GPIO → ULN2003, medio paso (opcional)</TD></TR>
      </TABLE>>];
  }
  { rank=same; legend; viewerP; }
}
